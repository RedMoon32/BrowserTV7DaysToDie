# Copy to .env on the bridge host. Use the same secret in Config/browser-tv.json.
BROWSER_TV_SERVER_SECRET=change-me-browser-tv-secret
# Use an address reachable by all players.
BROWSER_TV_PUBLIC_URL=http://127.0.0.1:8787
BROWSER_TV_DEFAULT_URL=https://www.google.com
# Match browserWidth/browserHeight in Config/browser-tv.json.
BROWSER_TV_WIDTH=1280
BROWSER_TV_HEIGHT=720
BROWSER_TV_FPS=30
