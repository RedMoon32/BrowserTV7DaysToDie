<?xml version="1.0" encoding="UTF-8"?>
<configs>
    <!-- YouTube TV Block Definition -->
    <append xpath="/blocks">
        <block name="YouTubeTV">
            <property name="Class" value="YouTubeTV, YoutubeTV"/>
            <property name="Material" value="Mmetal"/>
            <property name="StabilitySupport" value="false"/>
            <property name="Shape" value="ModelEntity"/>
            <property name="Model" value="#@modfolder:Resources/YoutubeTV.unity3d?Youtube_TV"/>
            <!-- <property name="MultiBlockDim" value="2,2,1"/> -->
            <property name="ImposterExchange" value="imposterBlock" param1="154"/>
            <property name="IsTerrainDecoration" value="true"/>
            <property name="Place" value="TowardsPlacerInverted"/>
            <property name="OnlySimpleRotations" value="true"/>
            <property name="CanPickup" value="true"/>
            <property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
            <property name="DisplayType" value="blockMulti"/>
            <property name="MaxDamage" value="800"/>
            <property name="Group" value="Building,advBuilding"/>
            <property name="EconomicValue" value="500"/>
            <property name="DescriptionKey" value="YouTubeTVDesc"/>
            <property name="RequiredPower" value="10"/>
            <property name="FilterTags" value="MC_playerBlocks,SC_electrical"/>
            
            <!-- Drop when destroyed -->
            <drop event="Destroy" name="resourceScrapIron" count="10,20"/>
            <drop event="Destroy" name="resourceElectricParts" count="2,5"/>
            
            <!-- Harvest properties -->
            <property name="HarvestOverdamage" value="false"/>
            <drop event="Harvest" name="resourceScrapIron" count="5,10" tag="allHarvest"/>
            <drop event="Harvest" name="resourceElectricParts" count="1,3" tag="allHarvest"/>
        </block>

        <block name="YouTubeTVWall">
            <property name="Class" value="YouTubeTV, YoutubeTV"/>
            <property name="Material" value="Mmetal"/>
            <property name="StabilitySupport" value="false"/>
            <property name="Shape" value="ModelEntity"/>
             <property name="RequiredPower" value="10"/>
            <property name="Model" value="#@modfolder:Resources/YoutubeTV.unity3d?Youtube_Wall"/>
            <!-- <property name="MultiBlockDim" value="2,2,1"/> -->
            <property name="ImposterExchange" value="imposterBlock" param1="154"/>
            <property name="IsTerrainDecoration" value="true"/>
            <property name="Place" value="TowardsPlacerInverted"/>
            <property name="OnlySimpleRotations" value="true"/>
            <property name="CanPickup" value="true"/>
            <property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
            <property name="DisplayType" value="blockMulti"/>
            <property name="MaxDamage" value="800"/>
            <property name="Group" value="Building,advBuilding"/>
            <property name="EconomicValue" value="500"/>
            <property name="DescriptionKey" value="YouTubeTVDesc"/>
            <property name="RequiredPower" value="10"/>
            <property name="FilterTags" value="MC_playerBlocks,SC_electrical"/>
            
            <!-- Drop when destroyed -->
            <drop event="Destroy" name="resourceScrapIron" count="10,20"/>
            <drop event="Destroy" name="resourceElectricParts" count="2,5"/>
            
            <!-- Harvest properties -->
            <property name="HarvestOverdamage" value="false"/>
            <drop event="Harvest" name="resourceScrapIron" count="5,10" tag="allHarvest"/>
            <drop event="Harvest" name="resourceElectricParts" count="1,3" tag="allHarvest"/>
        </block>

        <block name="YoutubeBigTV">
            <property name="Class" value="YouTubeTV, YoutubeTV"/>
            <property name="Material" value="Mmetal"/>
            <property name="StabilitySupport" value="false"/>
            <property name="Shape" value="ModelEntity"/>
            <property name="RequiredPower" value="20"/>
            <property name="Model" value="#@modfolder:Resources/YoutubeTV.unity3d?Youtube_BigTV"/>
            <property name="MultiBlockDim" value="2,2,1"/> 
            <property name="ImposterExchange" value="imposterBlock" param1="154"/>
            <property name="IsTerrainDecoration" value="true"/>
            <property name="Place" value="TowardsPlacerInverted"/>
            <property name="OnlySimpleRotations" value="true"/>
            <property name="CanPickup" value="true"/>
            <property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
            <property name="DisplayType" value="blockMulti"/>
            <property name="MaxDamage" value="800"/>
            <property name="Group" value="Building,advBuilding"/>
            <property name="EconomicValue" value="500"/>
            <property name="DescriptionKey" value="YouTubeTVDesc"/>
            <property name="RequiredPower" value="10"/>
            <property name="FilterTags" value="MC_playerBlocks,SC_electrical"/>

            <!-- Drop when destroyed -->
            <drop event="Destroy" name="resourceScrapIron" count="10,20"/>
            <drop event="Destroy" name="resourceElectricParts" count="2,5"/>

            <!-- Harvest properties -->
            <property name="HarvestOverdamage" value="false"/>
            <drop event="Harvest" name="resourceScrapIron" count="5,10" tag="allHarvest"/>
            <drop event="Harvest" name="resourceElectricParts" count="1,3" tag="allHarvest"/>
        </block>

        <block name="YoutubeTheaterScreen"> 
			<property name="CreativeMode" value="Player"/>
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="#@modfolder:Resources/YoutubeTV.unity3d?Youtube_Theater" />
			<property name="Class" value="YouTubeTV, YoutubeTV"/>		
			<property name="ActivationDistance" value="30"/>
            <property name="DisplayType" value="blockElectrical" />
            <property name="RequiredPower" value="30"/>
            <property name="CreativeMode" value="Player"/>
			<property name="MultiBlockDim" value="10,10,1" /> <!-- 21,10,1 actually, but will throw parent errors if larger than about 15 -->
			<property name="Material" value="Mweb"/>
			<property name="IsTerrainDecoration" value="true"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
			<property name="StabilitySupport" value="true"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="Stacknumber" value="1"/>
			<property name="TakeDelay" value="5"/>
			<property name="EconomicValue" value="2000"/>
			<property name="Group" value="Science"/>
			<!-- <property name="UnlockedBy" value="perkAdvancedEngineering"/> -->
			<property class="RepairItems"> <property name="resourceForgedIron" value="1"/> <property name="resourceElectricParts" value="3"/> </property>
			<drop event="Harvest" name="terrStone" count="0" tool_category="Disassemble"/>
			<drop event="Harvest" name="resourceElectricParts" count="1,4" tag="salvageHarvest"/> 
			<drop event="Destroy" name="resourceScrapIron" count="5" prob="1"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.25" stick_chance="1"/>
		</block>

        <block name="YoutubeBillboard"> 
			<property name="CreativeMode" value="Player"/>
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="#@modfolder:Resources/YoutubeTV.unity3d?Youtube_Billboard" /> <!-- Free model by stepanprokop -->
			<property name="Class" value="YouTubeTV, YoutubeTV"/>		
            <property name="DisplayType" value="blockElectrical" />
            <property name="RequiredPower" value="30"/>
            <property name="CreativeMode" value="Player"/>
			<property name="MultiBlockDim" value="1,14,1" />
			<property name="Material" value="Mmetal_medium"/>
			<property name="IsTerrainDecoration" value="true"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
			<property name="StabilitySupport" value="true"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="Stacknumber" value="1"/>
			<property name="TakeDelay" value="5"/>
			<property name="EconomicValue" value="2000"/>
			<property name="Group" value="Science"/>
			<!-- <property name="UnlockedBy" value="perkAdvancedEngineering"/> -->
			<property class="RepairItems"> <property name="resourceForgedIron" value="1"/> <property name="resourceElectricParts" value="3"/> </property>
			<drop event="Harvest" name="terrStone" count="0" tool_category="Disassemble"/>
			<drop event="Harvest" name="resourceElectricParts" count="1,4" tag="salvageHarvest"/> 
			<drop event="Destroy" name="resourceScrapIron" count="5" prob="1"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
		</block>
    </append>
</configs>
