<config>
  <append xpath="/windows">
    <window name="windowBrowserTvControl" width="620" height="360" panel="center" cursor_area="true" controller="BrowserTvControlWindow, BrowserTV">
      <rect name="mainRect" depth="0" pos="0,0" width="620" height="360">
        <sprite depth="0" name="background" sprite="menu_empty_background" color="[black]" type="sliced" fillcenter="true" />
        <label depth="1" name="lblTitle" pos="0,165" width="620" height="38" text="Browser TV" font_size="32" justify="center" />

        <rect depth="1" name="panelUrl" pos="0,0" width="620" height="280">
          <label depth="2" name="lblUrlTitle" pos="0,110" width="620" height="30" text="Browser URL" font_size="26" justify="center" />
          <textfield depth="2" name="txtBrowserTvUrl" pos="20,60" width="580" height="42" character_limit="512" focus_on_open="true" clear_on_open="false" open_vk_on_open="false" />
          <simplebutton name="btnBrowserTvUrlSubmit" depth="2" pos="230,-5" width="160" height="42" font_size="22" caption="Open" />
          <simplebutton name="btnBrowserTvVolume" depth="2" pos="160,-70" width="300" height="46" font_size="24" caption="Volume" />
          <simplebutton name="btnBrowserTvClose" depth="2" pos="230,-135" width="160" height="40" font_size="22" caption="Close" />
        </rect>

        <rect depth="1" name="panelVolume" pos="0,0" width="620" height="280" visible="false">
          <simplebutton name="btnBrowserTvVolumeBack" depth="2" pos="20,120" width="100" height="36" font_size="20" caption="Back" />
          <label depth="2" name="lblVolumeTitle" pos="120,122" width="380" height="30" text="Local volume" font_size="26" justify="center" />
          <rect name="browserTvVolumeSlider" controller="Slider" depth="2" pos="60,55" width="500" height="80">
            <label depth="3" pos="0,0" width="500" height="30" text="{name}: {value}" font_size="24" justify="center" />
            <rect depth="3" pos="2,-42">
              <sprite name="bar" controller="SliderBar" depth="4" pos="4,-5" color="[mediumGrey]" width="488" height="20" type="sliced" style="press, scroll" />
              <sprite depth="5" pos="4,-5" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" width="488" height="20" foregroundlayer="true" />
              <sprite name="thumb" controller="SliderThumb" depth="6" pos="492,-15" color="[lightGrey]" width="16" height="30" style="press, hover, drag, scroll" pivot="center">
                <sprite depth="7" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" width="16" height="30" pivot="center" />
              </sprite>
            </rect>
          </rect>
        </rect>
      </rect>
    </window>

    <window name="windowBrowserTvUrlInput" width="620" height="190" panel="center" cursor_area="true" controller="BrowserTvUrlInputWindow, BrowserTV">
      <rect name="mainRect" depth="0" pos="0,0" width="620" height="190">
        <sprite depth="0" name="background" sprite="menu_empty_background" color="[black]" type="sliced" fillcenter="true" />
        <label depth="1" name="lblPrompt" pos="0,42" width="600" height="34" text="Browser URL" font_size="28" justify="center" />
        <textfield depth="1" name="content" pos="20,-8" width="580" height="42" character_limit="512" focus_on_open="true" clear_on_open="false" open_vk_on_open="false" />
        <label depth="1" name="lblHint" pos="0,-58" width="600" height="26" text="Press Enter to open" font_size="20" justify="center" />
      </rect>
    </window>
  </append>
</config>
